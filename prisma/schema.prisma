generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model GenomicLabRegister {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  service_order_id       String?   @db.VarChar(100)
  mrn                    String    @db.VarChar(100)
  patient_name           String    @db.VarChar(255)
  patient_email          String?   @db.VarChar(255)
  mobile_no              String?   @db.VarChar(50)
  doctor_name            String?   @db.VarChar(255)
  age                    String?   @db.VarChar(50)
  gender                 String?   @db.VarChar(50)
  age_gender             String?   @db.VarChar(50)
  visit_id               String?   @db.VarChar(100)
  specimen               String?   @db.VarChar(255)
  service_name           String?   @db.VarChar(255)
  service_code           String?   @db.VarChar(100)
  bed_no                 String?   @db.VarChar(100)
  service_center_name    String?   @db.VarChar(255)
  order_date             String?   @db.VarChar(100)
  order_status           String?   @db.VarChar(100)
  accepted_date          String?   @db.VarChar(100)
  sample_accepted_by     String?   @db.VarChar(255)
  sam_accepted_by        String?   @db.VarChar(255)
  sample_collected_date  String?   @db.VarChar(100)
  lb_id                  String?   @db.VarChar(100)
  certified_by           String?   @db.VarChar(255)
  sample_send_date       String?   @db.VarChar(100)
  sample_send_by         String?   @db.VarChar(255)
  received_items         String?   @db.Text
  block_no               String?   @db.VarChar(100)
  cellularity            String?   @db.VarChar(255)
  diagnosis              String?   @db.Text
  received_date          String?   @db.VarChar(100)
  expected_date          String?   @db.VarChar(100)
  process_status         String?   @default("In-Progress") @db.VarChar(50)
  zygene_number          String?   @db.VarChar(100)
  genomic_services       String?   @db.VarChar(255)
  histo_services         String?   @db.Text
  emailed_status         Boolean   @default(false)
  emailed_date           DateTime? @db.Timestamptz(6)
  uploaded_report_status Boolean   @default(false)
  uploaded_report_date   DateTime? @db.Timestamptz(6)
  print_report_status    Boolean   @default(false)
  print_report_date      DateTime? @db.Timestamptz(6)
  others                 String?   @db.Text

  mst_siteid             Int       @default(1)
  status                 Boolean   @default(true)

  created_at             DateTime  @default(now()) @db.Timestamptz(6)
  updated_at             DateTime  @updatedAt @db.Timestamptz(6)
  created_by             String?   @db.Uuid
  updated_by             String?   @db.Uuid
  deleted_by             String?   @db.Uuid
  created_by_name        String?   @db.VarChar(255)
  updated_by_name        String?   @db.VarChar(255)
  deleted_by_name        String?   @db.VarChar(255)
  deleted_at             DateTime? @db.Timestamptz(6)

  @@index([mst_siteid])
  @@index([deleted_at])
  @@map("genomic_lab_register")
}

model GenomicServiceMaster {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  service_name     String    @db.VarChar(255)
  service_code     String    @unique @db.VarChar(100)
  price            Decimal   @db.Decimal(10, 2)
  sample           String    @db.VarChar(100)
  tat_time         String?   @db.VarChar(100)
  status           Boolean   @default(true)
  mst_siteid       Int       @default(1)

  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  updated_at       DateTime  @updatedAt @db.Timestamptz(6)
  deleted_at       DateTime? @db.Timestamptz(6)
  created_by       String?   @db.Uuid
  updated_by       String?   @db.Uuid
  deleted_by       String?   @db.Uuid
  created_by_name  String?   @db.VarChar(255)
  updated_by_name  String?   @db.VarChar(255)
  deleted_by_name  String?   @db.VarChar(255)

  @@index([mst_siteid])
  @@index([deleted_at])
  @@map("genomic_service_masters")
}

model UserLabPermission {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id          String    @db.VarChar(100)
  emp_id           String?   @db.VarChar(100)
  user_name        String?   @db.VarChar(255)
  user_email       String?   @db.VarChar(255)
  module_key       String    @db.VarChar(100)
  can_read         Boolean   @default(true)
  can_create       Boolean   @default(false)
  can_update       Boolean   @default(false)
  can_delete       Boolean   @default(false)
  can_export       Boolean   @default(false)
  allowed_site_ids Int[]     @default([1])

  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  updated_at       DateTime  @updatedAt @db.Timestamptz(6)

  @@unique([user_id, module_key])
  @@index([user_id])
  @@index([emp_id])
  @@map("user_lab_permissions")
}

model HistoServiceMaster {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  service_name     String    @db.VarChar(255)
  service_code     String    @unique @db.VarChar(100)
  price            Decimal   @default(0.00) @db.Decimal(10, 2)
  sample           String    @default("INHOUSE") @db.VarChar(100)
  tat_time         String?   @db.VarChar(100)
  status           Boolean   @default(true)
  mst_siteid       Int       @default(1)

  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  updated_at       DateTime  @updatedAt @db.Timestamptz(6)
  deleted_at       DateTime? @db.Timestamptz(6)
  created_by       String?   @db.Uuid
  updated_by       String?   @db.Uuid
  deleted_by       String?   @db.Uuid
  created_by_name  String?   @db.VarChar(255)
  updated_by_name  String?   @db.VarChar(255)
  deleted_by_name  String?   @db.VarChar(255)

  @@index([mst_siteid])
  @@index([deleted_at])
  @@map("histo_service_masters")
}
